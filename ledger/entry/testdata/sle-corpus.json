    "rippled-3.2.0-ledgerfile-oracle": {
      "independent": true,
      "source": "xrpllabsofficial/xrpld:3.2.0 linux/amd64 image digest sha256:aafb23a09e2b8ea1573704dcc0b5fd686fdb6284c00dca33f640726133e8414d; xrpld commit 3c43f4614f87965298773279ff5b85d4c56c637b (release-3.2)",
      "detail": "JSON maps were loaded into a standalone ledger with --ledgerfile and captured through binary ledger_data, exercising rippled's STParsedJSONObject, STLedgerEntry template application, and serializeHex paths. Canonical default-valued fields were omitted, and the NegativeUNL inner DisabledValidator included its required FirstLedgerSequence."
    },
    "rippled-ledger-entry-test": {
      "independent": true,
      "source": "local rippled tag 3.0.0, src/test/rpc/LedgerEntry_test.cpp:testLedgerEntryAccountRoot/alicesAcctRootBinary",
      "detail": "A byte-for-byte node_binary assertion produced by a rippled ledger-entry RPC test."
    },
    "rippled-3.3.0-rc1-sponsor-protocol": {
      "independent": true,
      "source": "XRPLF/rippled commit 18e311e1e245bcc1813363bd1771b94931585d80: sfields.macro, ledger_entries.macro, LedgerFormats.cpp, and the protocol_autogen Sponsorship tests",
      "detail": "Fixed bytes were independently assembled from rippled's tagged field ordinals, SOTemplate order, canonical AccountID payloads, and native-amount encoding. They cover the new common trust-line sponsor fields and every non-default Sponsorship SLE field."
    }
