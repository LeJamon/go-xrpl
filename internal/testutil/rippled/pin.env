# The rippled release go-xrpl targets. Single source for Go tests
# (internal/testutil/rippled.Pin), scripts, the justfile and CI.
# Bump procedure: docs/upgrading-rippled.md.
#
# Format: KEY=value, one per line, no quotes, spaces or expansions, so the file
# is valid as a shell fragment, a $GITHUB_ENV append and a trivial parse.

# Behaviour oracle: the tagged release, its private commit and the public
# commit whose protocol inventory sources are byte-identical.
ORACLE_TAG=3.4.1
ORACLE_REPOSITORY=XRPLF/xrpld-private
ORACLE_COMMIT=d147fccf54a500fce586522f28d6044c37fd8d29
ORACLE_PUBLIC_REPOSITORY=XRPLF/rippled
ORACLE_PUBLIC_COMMIT=00e640751460c137636fdb6dae6b4280de355d81
# Checkout location, relative to the repository root or any of its parents.
ORACLE_CHECKOUT=rippled-worktrees/v3.4.1-oracle

# Release package behind scripts/peer-interop/Dockerfile.
ORACLE_IMAGE=goxrpl-oracle:3.4.1
ORACLE_PACKAGE_URL=https://packages.xrplf.org/repository/deb-stable/pool/x/xrpld/xrpld_3.4.1-1_amd64.deb
ORACLE_PACKAGE_SHA256=cae8ce3b9bc9451b19975c890714ba789d2004987cdfff9cbd55522c612c6f26
ORACLE_BINARY_SHA256=fb8430dfdbee9d8016818dab22881e48a125598beebf9b5b8c90ca7fdba1faaa

# Version-named artefacts recorded from the oracle, relative to the repository root.
ORACLE_CORPUS=internal/testing/conformance/testdata/rippled-3.4.1-v4
ORACLE_FINAL_OUTCOMES=internal/testing/conformance/testdata/final-outcomes-3.4.1
ORACLE_AMENDMENT_REGISTRY=amendment/testdata/private3.4.1_registry.json
ORACLE_DEFINITIONS_SHA512_HALF=1EA05B0FC11101F7C500BD0DAC794A8BC746A7FBA6250B75489603EB820E0FF5
ORACLE_DEFINITIONS_BYTES=79944

# Historical: the previous public release. A discovered checkout of it is still
# accepted for the hash-pinned inventory sources, and the legacy corpus format
# was recorded against it.
ORACLE_PRIOR_TAG=3.4.0
ORACLE_PRIOR_REPOSITORY=XRPLF/rippled
ORACLE_PRIOR_COMMIT=4a4fded2eba11427c48ce3f24d9c1aea5e7a9d17
ORACLE_PRIOR_CHECKOUT=rippled-worktrees/v3.4.0-oracle
